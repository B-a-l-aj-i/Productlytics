{
  "name": "Productlytics",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r --if-present build",
    "check-types": "pnpm -r check-types",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "db:push": "pnpm --filter @Productlytics/db db:push",
    "db:studio": "pnpm --filter @Productlytics/db db:studio",
    "db:generate": "pnpm --filter @Productlytics/db db:generate",
    "db:migrate": "pnpm --filter @Productlytics/db db:migrate"
  },
  "dependencies": {
    "@Productlytics/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Productlytics/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.26.2"
}
