# Copy to .env and adjust for your machine: cp .env.example .env

# Frontend origin allowed by CORS (Vite dev server)
CORS_ORIGIN=http://localhost:3001

# Local Postgres connection — adjust user/password to your setup
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Signs the session cookie (JWT). Any long random string works locally.
JWT_SECRET=local-dev-jwt-secret-change-me
